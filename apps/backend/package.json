{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "node prisma/select-schema.js",
    "build": "tsc && npx tsc prisma/seed.ts --outDir dist/prisma --module CommonJS --target ES2022 --moduleResolution node --esModuleInterop --skipLibCheck && npx prisma generate",
    "start": "node dist/main.js",
    "dev": "node prisma/select-schema.js && nodemon --watch src -e ts --exec ts-node src/main.ts",
    "test": "jest --passWithNoTests",
    "prisma:generate": "node prisma/select-schema.js && prisma generate",
    "prisma:migrate": "node prisma/select-schema.js && prisma migrate dev",
    "prisma:db:push": "node prisma/select-schema.js && prisma db push --accept-data-loss",
    "prisma:seed": "node prisma/select-schema.js && node dist/prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.24",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^5.10.0",
    "redis": "^4.6.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
